# Monorepo .gitignore

# --- Node.js / React ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
build/
dist/

# Local env files
.env
.env.local
.env.*.local

# Logs
logs
*.log
*.log.*
*.out
*.err

# Coverage / Testing
coverage/
.vitest/

# --- Java / Spring Boot ---
# Compiled class files
*.class

# Java logs
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Java package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# --- Docker ---
*.pid
*.seed
*.pid.lock

# --- IDE/editor ---
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project

# --- Metals (Scala/Java tooling) ---
.metals/

# --- MacOS ---
.DS_Store

# --- Optional lockfiles ---
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
